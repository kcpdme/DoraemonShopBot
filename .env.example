# Create a bot through @BotFather, then set these values in your deployment environment.
BOT_TOKEN=
OWNER_TELEGRAM_ID=
SALES_CHANNEL=@your_sales_channel
BEP20_USDT_ADDRESS=
POLYGON_USDT_ADDRESS=
# Set exact official USDT token contract addresses. Symbols alone are unsafe.
BEP20_USDT_CONTRACT=
POLYGON_USDT_CONTRACT=
# Optional custom RPC providers. Defaults are free public fallbacks.
BSC_RPC_URL=https://bsc-rpc.publicnode.com
POLYGON_RPC_URL=https://polygon-bor-rpc.publicnode.com
# Optional; defaults to data/store.json
DATA_FILE=data/store.json

# Optional Telegram Mini App. Leave MINI_APP_PUBLIC_URL empty for bot-only mode.
# Telegram requires a publicly reachable HTTPS URL. Put a reverse proxy in front
# of the local listener; do not expose the listener directly to the internet.
MINI_APP_PUBLIC_URL=
MINI_APP_LISTEN_ADDR=127.0.0.1:8080

# Optional hourly group promo (scripts/promo/post.py). User account, not the bot token.
# Create api_id / api_hash at https://my.telegram.org then run: python3 scripts/promo/post.py --login
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_SESSION=data/promo.session
PROMO_GROUPS=ChatgptPlusDeal
PROMO_DELAY_SECONDS=8
