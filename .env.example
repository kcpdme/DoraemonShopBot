# Create a bot through @BotFather, then set these values in your deployment environment.
BOT_TOKEN=
OWNER_TELEGRAM_ID=
SALES_CHANNEL=@your_sales_channel
BEP20_USDT_ADDRESS=
POLYGON_USDT_ADDRESS=
# One Etherscan V2 key verifies both BSC (chain 56) and Polygon (chain 137).
ETHERSCAN_API_KEY=
# Set exact official USDT token contract addresses. Symbols alone are unsafe.
BEP20_USDT_CONTRACT=
POLYGON_USDT_CONTRACT=
# Optional; defaults to data/store.json
DATA_FILE=data/store.json
